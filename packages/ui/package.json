    "jsdom": "^26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vitest": "^3.2.7",
    "@signal/config": "workspace:*",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@signal/contracts": "workspace:*"

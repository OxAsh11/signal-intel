# Copy to .env at the repo root (web and worker both read it). Never commit real values.
# Values come from Supabase → Project Settings → API / Database, and from each provider's console.

# ── Supabase (web + worker) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=

# Server-only. Worker and server actions that run as the system. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Worker: session pooler (port 5432) — needed for LISTEN/NOTIFY and Procrastinate.
DATABASE_URL_SESSION=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Web server code that needs SQL: transaction pooler (port 6543).
DATABASE_URL_POOLED=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── AI gateway (worker) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
AI_MODEL_EXTRACT=claude-sonnet-5-5
AI_MODEL_JUDGE=claude-sonnet-5-5
AI_MODEL_PREJUDGE=claude-haiku-5-5
AI_MODEL_WRITE=claude-sonnet-5-5
AI_MODEL_EMBED=voyage-4

# ── Stored secrets and enrichment (worker + API) ─────────────────────────
# Fernet key that encrypts webhook secrets, integration signing secrets and contact values
# stored in the database. Required for webhooks, inbound events and enrichment. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: set to "<new>,<old>"; new values use the first key and both can read.
SECRETS_ENCRYPTION_KEY=
# Enrichment provider (M7). Leave empty to keep enrichment off ("Not set up yet").
HUNTER_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────
APP_ENV=local            # local | staging | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info
SENTRY_DSN=
PORT=8080                # worker health server (Railway sets this)

# Worker: Supabase project URL for Storage access (same value as NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=https://<project-ref>.supabase.co
